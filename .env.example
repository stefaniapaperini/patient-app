# Copy this file to .env and fill in both values (no quotes).
# .env is ignored by git and by Docker builds: never commit real values.

# Base URL of the FHIR R4 server, without a trailing slash.
FHIR_BASE_URL=https://your-fhir-server/fhir

# Bearer token for that server. Only the app's server-side proxy reads it;
# it is never sent to the browser.
FHIR_TOKEN=your-bearer-token

# --- Imaging (optional) ---
# DICOMweb server for the patient page's imaging viewer (read-only: QIDO-RS search, WADO-RS
# rendered images). Leave DICOMWEB_QIDO_URL empty to hide the imaging section.
# Servers with one DICOMweb root only need DICOMWEB_QIDO_URL; this public test server has two.
# The public server is for testing only: never use it with real patient data.
DICOMWEB_QIDO_URL=https://dicomserver.co.uk:8989/qido
DICOMWEB_WADO_URL=https://dicomserver.co.uk:8989/wado

# Demo links, as fhirPatientId:DicomPatientID pairs separated by commas. A linked patient shows
# the images of that example DICOM patient, clearly marked as demo images of another person.
DICOM_DEMO_PATIENTS=
